# Supabase (publishable values — safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Inquiry email → studio inbox (default: mgcarchitectureph@gmail.com)
# INQUIRY_NOTIFY_EMAIL=mgcarchitectureph@gmail.com
#
# Preferred: Resend branded HTML. Sign up at https://resend.com with the studio Gmail.
# Until a custom domain is verified on Resend, use onboarding@resend.dev as from
# (only delivers to the Resend account owner email — use the studio Gmail account).
# RESEND_API_KEY=re_xxxxxxxx
# INQUIRY_FROM_EMAIL=MGC Architecture <onboarding@resend.dev>
#
# Without RESEND_API_KEY the API falls back to FormSubmit → same Gmail
# (confirm the first activation email from FormSubmit once).
# INQUIRY_EMAIL_DRY_RUN=1
